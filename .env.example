# OpenAI 默认方案
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 国产/第三方 OpenAI-compatible 平替方案
# AI_PROVIDER 可填：openai | dashscope | qianfan | custom
# dashscope 推荐：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-plus 或 qwen3-vl-flash
# qianfan 可选：
# AI_BASE_URL=https://qianfan.baidubce.com/v2
# AI_MODEL=千帆控制台里的视觉模型 API 名称
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=learning-card-media
NEXT_PUBLIC_APP_URL=http://localhost:3000
